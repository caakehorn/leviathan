root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{js,html,yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Generated, single-line, and very large — editors should leave it alone.
[data/wiki-data.json]
insert_final_newline = false
trim_trailing_whitespace = false
